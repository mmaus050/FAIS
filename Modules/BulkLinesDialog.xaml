<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add bulk lines" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock Text="Add bulk lines" FontSize="15" FontWeight="Bold"/>
        <TextBlock x:Name="DayText" Foreground="#475569" Margin="0,2,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Start time:" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <TextBox x:Name="StartTimeBox" Width="70" FontFamily="Consolas" FontSize="13" Padding="3,2"/>
                <TextBlock Text="e.g. 0730" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Number of lines:" VerticalAlignment="Center"/>
            <TextBox x:Name="CountBox" Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left" FontFamily="Consolas" FontSize="13" Padding="3,2" Margin="0,3"/>

            <TextBlock Grid.Row="2" Text="Minutes between lines:" VerticalAlignment="Center"/>
            <TextBox x:Name="IntervalBox" Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left" FontFamily="Consolas" FontSize="13" Padding="3,2" Margin="0,3"/>

            <TextBlock Grid.Row="3" Text="Line type:" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeCombo" Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,3"/>
        </Grid>

        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="34"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Add lines" Padding="18,4" Margin="3,0" FontWeight="Bold" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Padding="10,3" Margin="3,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
